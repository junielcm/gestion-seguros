# ==============================================================================
# VARIABLES DE ENTORNO - Docker Compose
# ==============================================================================
# Copia este archivo a .env y ajusta los valores:
#   cp .env.example .env
#
# NUNCA subas el archivo .env a un repositorio público.
#
# Docker Compose lee este archivo automáticamente desde la carpeta donde está
# el docker-compose.yml. Todos los valores tienen un valor por defecto en el
# compose, así que la app arranca incluso sin este archivo.
# ==============================================================================

# ------------------------------------------------------------------------------
# Puertos
# ------------------------------------------------------------------------------
# Puerto del host donde se publica la aplicación (frontend + API + admin).
FRONTEND_PORT=8080

# ------------------------------------------------------------------------------
# Django
# ------------------------------------------------------------------------------
# En Docker déjalo en False: gunicorn no sirve archivos estáticos (los sirve
# nginx) y DEBUG=True expone detalles de los errores.
DEBUG=False

# IMPORTANTE: genera una clave única antes de desplegar en un servidor real.
#   docker compose run --rm backend python -c "from django.core.management.utils \
#     import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-cambia-esta-clave-en-produccion

# Dominios permitidos, separados por comas. Para pruebas locales '*' está bien;
# en producción pon los dominios reales, p. ej.:
#   ALLOWED_HOSTS=app.midominio.com,api.midominio.com
ALLOWED_HOSTS=*

# ------------------------------------------------------------------------------
# Base de datos
# ------------------------------------------------------------------------------
# Por defecto SQLite en el volumen `backend_data`.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=/app/data/db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
# Segundos que espera el backend a que la base de datos responda al arrancar.
DB_WAIT_TIMEOUT=60

# ------------------------------------------------------------------------------
# Comportamiento del arranque
# ------------------------------------------------------------------------------
# true  = ejecuta setup_demo.py en cada `docker compose up` (idempotente:
#         usa get_or_create, no duplica clínicas, usuarios ni póliza).
# false = solo aplica migraciones. Úsalo en un entorno real.
LOAD_DEMO_DATA=true

# Número de procesos de gunicorn. Como regla práctica: (núcleos de CPU * 2) + 1
GUNICORN_WORKERS=3

# ------------------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------------------
# Se incrusta en el bundle en tiempo de build. Déjalo como '/api/v1/' para
# Docker (nginx hace de proxy). Solo cámbialo si sirves la API en otro dominio;
# en ese caso usa https y configura CORS_ALLOWED_ORIGINS en el backend.
VITE_API_URL=/api/v1/

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------
# En este setup todo es same-origin a través de nginx, así que CORS no hace
# falta. Pónlo en False y define CORS_ALLOWED_ORIGINS si separas los dominios.
CORS_ALLOW_ALL_ORIGINS=True

# ------------------------------------------------------------------------------
# HTTPS (opcional)
# ------------------------------------------------------------------------------
# Déjalo apagado mientras sirvas HTTP plano en el puerto 8080.
# Actívalo solo cuando haya un terminador TLS delante (Traefik, Caddy, un
# balanceador) Y hayas cambiado ya las variables de arriba.
#
# AVISO: activar HSTS sin HTTPS real deja el dominio inaccesible durante el
# periodo configurado. Lee la documentación de Django antes de habilitarlo.
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
